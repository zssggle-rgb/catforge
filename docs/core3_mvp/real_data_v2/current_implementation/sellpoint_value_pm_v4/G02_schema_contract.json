{
  "contract_version": "sellpoint_value_pm_v4_contract_v1",
  "implementation_target": "Pydantic v2 extra=forbid",
  "enums": {
    "Availability": ["present", "missing"],
    "Usability": ["usable", "limited", "unusable"],
    "IssueSeverity": ["info", "warning", "blocking"],
    "LineageStatus": ["aligned", "stale_revalidated", "stale_conflict", "unresolved"],
    "ValueStatus": ["established", "partial", "not_observed", "conflicted"],
    "QuantificationLevel": [
      "Q0_NOT_OBSERVED",
      "Q1_USER_VALUE_ESTABLISHED",
      "Q2_RELATIVE_EXPERIENCE",
      "Q3_MARKET_CHOICE_ASSOCIATION",
      "Q4_WHOLE_PRODUCT_PRICE_ACCEPTANCE",
      "Q5_MARKET_IMPLIED_WTP"
    ],
    "ProductRole": [
      "core_differentiated_value",
      "basic_threshold",
      "supporting_choice_value",
      "customer_captured_value",
      "configuration_support",
      "price_pressure",
      "undetermined"
    ],
    "MonetizationStatus": [
      "not_measured",
      "choice_supported",
      "whole_product_only",
      "partially_captured",
      "fully_captured",
      "over_captured",
      "unidentifiable"
    ],
    "CounterfactualRole": ["base_value", "same_value", "stretch_benchmark"],
    "CandidateProvenance": ["M14", "competitor_set_fallback", "M12C_pool", "same_family_search"],
    "IsolationGrade": ["A", "B", "C", "unusable"],
    "BusinessTier": ["unknown", "base", "enhanced", "premium", "flagship"],
    "LinkStatus": ["supported", "partial", "conflicted", "insufficient"],
    "AnalysisStatus": ["ready", "partial", "blocked"],
    "WtpMethod": ["none", "matched_equal_choice_price_gap"]
  },
