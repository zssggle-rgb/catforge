  "invariants": [
    "unknown is never coerced to false or zero",
    "quantification levels are monotonic and cannot be skipped",
    "Q5 requires MarketImpliedWtp.status=available",
    "Q5 requires at least two independent A-grade pairs from at least two model families",
    "WTP method is never sourced from M12C allocated amounts",
    "same_value_only cannot reach Q5",
    "full_collinearity prevents single capability WTP",
    "version_lineage_conflict blocks affected price attribution",
    "business DTO does not contain automatic configuration or pricing actions",
    "result_hash excludes generated_at and delivery URLs"
  ]
}
